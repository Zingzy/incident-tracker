server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  location /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # Used by docker compose and kubectl port-forward. Through the Ingress, /api never reaches this pod.
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
